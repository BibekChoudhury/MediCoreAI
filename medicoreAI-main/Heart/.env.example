# Heart Health Module v2 - Environment Variables

# Database (default: SQLite)
DATABASE_URL=sqlite:///heart_health.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/heart_health

# JWT Authentication
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Fit API (optional)
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=

# Fitbit API (optional)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Voice/TTS (optional)
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=

# Featherless AI API (OpenAI-compatible)
FEATHERLESS_API_KEY=your-featherless-key-here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Llama-3-8B-Instruct

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Email Alerts (optional)
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Uploads
MAX_UPLOAD_SIZE_MB=50
